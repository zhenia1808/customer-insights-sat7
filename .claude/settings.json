{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "mcp__*",
      "Read(.env)",
      "Read(.env.*)",
      "Read(/data/**)",
      "Read(/outbox/**)",
      "Read(/models/**)",
      "Read(**/*.db)",
      "Read(**/*.sqlite)",
      "Read(**/*.sqlite3)",
      "Read(**/*.joblib)",
      "Read(**/*.pkl)",
      "Read(**/*.pickle)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(/data/**)",
      "Edit(/outbox/**)",
      "Edit(/models/**)",
      "Edit(**/*.db)",
      "Edit(**/*.sqlite)",
      "Edit(**/*.sqlite3)",
      "Edit(**/*.joblib)",
      "Edit(**/*.pkl)",
      "Edit(**/*.pickle)"
    ],
    "ask": [
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(npx *)",
      "Bash(pip install *)",
      "Bash(python -m pip install *)",
      "Bash(uv add *)",
      "Bash(npm install *)",
      "Bash(gh *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)"
    ]
  }
}
